# Sonarr address (TV shows)
SONARR_URL=http://localhost:8989
# Sonarr -> Settings -> General -> API Key
SONARR_API_KEY=
# Radarr address (movies)
RADARR_URL=http://localhost:7878
# Radarr -> Settings -> General -> API Key
RADARR_API_KEY=
# true = only shows / movies that actually have files
SONARR_ONLY_DOWNLOADED=false
RADARR_ONLY_DOWNLOADED=false
RADARR_ONLY_UNMONITORED=true
# https://trakt.tv/oauth/applications -> your app's Client ID
TRAKT_CLIENT_ID=
# Trakt username (profile must be public)
TRAKT_USER=
# true = titles you rated highly on Trakt become favorites (default false: sync never changes favorites)
TRAKT_SYNC_FAVORITES=false
# Minimum Trakt rating (1-10) that counts as a favorite
TRAKT_FAV_MIN_RATING=9
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Last.fm username
LASTFM_USER=
# top = your top albums | recent = built from your scrobble history (slower)
LASTFM_SOURCE=top
# overall | 7day | 1month | 3month | 6month | 12month
LASTFM_PERIOD=overall
# How many of your most played albums to import (0 = all of them)
LASTFM_LIMIT=1024
# Fallback posters + genres/countries/creators for shows & movies
TMDB_API_KEY=
# https://developer.spotify.com/dashboard -> your app's Client ID
SPOTIFY_CLIENT_ID=
# https://developer.spotify.com/dashboard -> your app's Client secret
SPOTIFY_CLIENT_SECRET=
# Redirect address of your Spotify app for the sign-in (http, 127.0.0.1 or localhost, with a port; it must be listed in the app's Redirect URIs)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
# true = albums of your liked songs are imported when you sync from your Spotify account
SPOTIFY_LIKED=false
# true = albums of your playlists are imported when you sync from your Spotify account
SPOTIFY_PLAYLISTS=false
# true = albums of your top songs (Spotify's ranking of what you play most) are imported when you sync from your Spotify account
SPOTIFY_TOP=true
# Songs an album needs in top songs / liked songs / playlists to be imported by an account sync (saved albums always count). The file import has its own setting
SPOTIFY_MIN_SONGS=3
